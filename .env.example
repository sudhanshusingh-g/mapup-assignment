# PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geofencing

# Go Backend API
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/geofencing?sslmode=disable
ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
# Optional: set API_KEY to enforce X-API-Key / Bearer auth
API_KEY=

# React Frontend (used at build time for Vite)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=
